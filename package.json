{
  "name": "stdinman.ts",
  "version": "0.2.0",
  "description": "Pipe audio sources to Discord voice with a bot using discord.js and DAVE-capable @discordjs/voice.",
  "type": "module",
  "author": "tionis.dev",
  "contributors": [
    "ckcr4lyf"
  ],
  "license": "WTFPL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tionis/stdinman.ts.git"
  },
  "homepage": "https://github.com/tionis/stdinman.ts#readme",
  "bugs": {
    "url": "https://github.com/tionis/stdinman.ts/issues"
  },
  "keywords": [
    "discord",
    "voice",
    "audio",
    "bot",
    "ffmpeg",
    "spotify",
    "librespot",
    "pipewire",
    "pulseaudio"
  ],
  "bin": {
    "stdinman": "./dist/stdinman.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "bun build ./ts/stdinman.ts --target node --packages external --outfile ./dist/stdinman.js",
    "dev": "bun run ./ts/stdinman.ts",
    "start": "node ./dist/stdinman.js",
    "check": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
